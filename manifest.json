{
  "manifest_version": 3,
  "name": "笙维起始页",
  "version": "1.0.0",
  "description": "Shengwei Start - 一个简洁美观的Edge浏览器新标签页起始页扩展",
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.bing.com/",
    "https://suggestion.baidu.com/",
    "https://api.bing.com/",
    "https://suggestqueries.google.com/",
    "https://www.google.com/s2/favicons",
    "http://*/*",
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
